# ==========================================
# KOYEB / BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Firebase Admin SDK (Option 1: Base64 Service Account)
# Highly recommended for Koyeb. Encode your JSON file to base64.
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account_json

# Firebase Admin SDK (Option 2: Individual variables)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourKeyHere\n-----END PRIVATE KEY-----\n"

# Supabase (For PostgreSQL access and Realtime)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
DATABASE_URL=your_postgres_connection_string
 
# Slack Bot Integration
SLACK_BOT_TOKEN=your_slack_bot_token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_APP_TOKEN=xapp-your-slack-app-token

# AI Providers
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GROQ_API_KEY=your_groq_api_key

# Nodemailer / Email (Optional for automated reports)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Client URL (For CORS & redirects)
CLIENT_URL=https://olive-pizza.vercel.app
