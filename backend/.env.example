# ==============================================================================
# 🍕 Olive Pizza Canonical Backend — Environment Configuration Template (.env.example)
# NOTE: DO NOT commit actual secrets to version control. Keep all credentials server-side.
# ==============================================================================

PORT=5000
NODE_ENV=development

# ==============================
# DATABASE ENVIRONMENT & POSTGRESQL
# ==============================
# DATABASE_ENV options: 'development' | 'testing' | 'render-test' | 'staging' | 'production' | 'vps'
DATABASE_ENV=render-test

# Render PostgreSQL (Testing / Staging — Pre-VPS Migration)
RENDER_POSTGRES_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require
RENDER_POSTGRES_HOST=
RENDER_POSTGRES_PORT=5432
RENDER_POSTGRES_DATABASE=olivepizza
RENDER_POSTGRES_USER=
RENDER_POSTGRES_PASSWORD=

# Main / VPS Production PostgreSQL (Authoritative Business Store)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require
VPS_POSTGRES_URL=

# PostgreSQL Connection Pool Limits
POSTGRES_POOL_MAX=20
POSTGRES_POOL_IDLE_TIMEOUT_MS=30000
POSTGRES_POOL_CONN_TIMEOUT_MS=10000
PG_SSL_REJECT_UNAUTHORIZED=false

# ==============================
# SUPABASE — STRICTLY FOR RIDER LIVE GPS ONLY
# ==============================
# Used exclusively for high-frequency GPS breadcrumbs (navigation_points & delivery_locations).
# MUST NOT be used for general business data, products, orders, or users.
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_ANON_KEY=

# ==============================
# MULTI-PROVIDER LOCATION SERVICES
# ==============================
# 1. Mapbox Geocoding & Search
MAPBOX_ACCESS_TOKEN=pk.eyJ1Ijoi...

# 2. Geoapify Geocoding API
GEOAPIFY_API_KEY=

# 3. Mappls (MapmyIndia) Search API
MAPPLS_API_KEY=

# 4. OpenStreetMap Nominatim (Public throttled at max 1 req/sec app-wide)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=OlivePizzaApp/1.0 (contact: olivepizzarjn@gmail.com; platform: backend)

# ==============================
# FIREBASE ADMIN SDK & CLIENT
# ==============================
FIREBASE_SERVICE_ACCOUNT_BASE64=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ==============================
# CLOUDINARY (Media Storage)
# ==============================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================
# SMTP TRANSACTIONAL EMAIL
# ==============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Olive Pizza <noreply@olivepizza.com>"
OWNER_EMAIL=

# ==============================
# REDIS (Optional Fast Cache & Locks)
# ==============================
REDIS_URL=redis://default:password@hostname:6379
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================
# AI PROVIDERS (Knowledge & RAG)
# ==============================
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ASSISTANT_NVIDIA_API_KEY=
ASSISTANT_OPENROUTER_API_KEY=
ASSISTANT_GEMINI_API_KEY=
