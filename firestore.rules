rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role in ['admin', 'owner', 'developer', 'platform_owner', 'restaurant_manager'] ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)(olivepizzarjn@gmail\\.com|webhub2811@gmail\\.com|samyakshrivastava28@gmail\\.com|ssamyak265@gmail\\.com|s\\.callhub2811@gmail\\.com|samyaks695@gmail\\.com|shrivastavadhirendra587@gmail\\.com|shrishikhar184@gmail\\.com|homkumarsahu@gmail\\.com)')) ||
        request.auth.uid in [
          'ZzMmHLa6fBeDYY7clYNjP70fbiE2',
          '6tLLR6q7aTYqzTG2blRx3TU5sA42',
          'Zf1MDESejSPbVLdKdAAB7xGGUV42',
          '4JhyFDVHmrcbnE95lxeT3TprlsY2',
          'zRZ60M8P5oXBXMU3Y1LMV3YlmGH3',
          'Uln5UKsRyZaCzTePgBmfourQngu1',
          'luEQTDTTtnReIOtK3lwfSn8F1i92',
          'pF2XORJbdtXtJmrOPMQxB8TbFhx1',
          'alWThK3kB4Wv0dhIaVuSxOyUaAI2'
        ] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin', 'developer', 'platform_owner'])
      );
    }

    function isAppOwner() {
      return request.auth != null && (
        request.auth.token.role in ['owner', 'admin', 'developer', 'platform_owner'] ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)(olivepizzarjn@gmail\\.com|webhub2811@gmail\\.com|samyakshrivastava28@gmail\\.com|ssamyak265@gmail\\.com|s\\.callhub2811@gmail\\.com|samyaks695@gmail\\.com|shrivastavadhirendra587@gmail\\.com|shrishikhar184@gmail\\.com|homkumarsahu@gmail\\.com)')) ||
        request.auth.uid in [
          'ZzMmHLa6fBeDYY7clYNjP70fbiE2',
          '6tLLR6q7aTYqzTG2blRx3TU5sA42',
          'Zf1MDESejSPbVLdKdAAB7xGGUV42',
          '4JhyFDVHmrcbnE95lxeT3TprlsY2',
          'zRZ60M8P5oXBXMU3Y1LMV3YlmGH3',
          'Uln5UKsRyZaCzTePgBmfourQngu1',
          'luEQTDTTtnReIOtK3lwfSn8F1i92',
          'pF2XORJbdtXtJmrOPMQxB8TbFhx1',
          'alWThK3kB4Wv0dhIaVuSxOyUaAI2'
        ] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin', 'developer', 'platform_owner'])
      );
    }

    function hasFullAccess() {
      return isAdmin() || isAppOwner();
    }

    function isDeliveryPartner() {
      return request.auth != null && request.auth.token.role == 'delivery_partner';
    }

    // --- PROTECTED BUSINESS COLLECTIONS ---
    
    match /users/{userId} {
      allow read: if isOwner(userId) || hasFullAccess();
      // Only admins can change role, franchiseId, branchId, terminalId, or administrative flags
      // Non-admins can only write customer fields (name, phone, address, photoURL) and CANNOT self-promote
      allow create: if hasFullAccess() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'customer') &&
        (!('franchiseId' in request.resource.data)) &&
        (!('branchId' in request.resource.data)) &&
        (!('terminalId' in request.resource.data)) &&
        (!('isOwner' in request.resource.data) || request.resource.data.isOwner == false) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
      );
      allow update: if hasFullAccess() || (
        isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'franchiseId', 'branchId', 'terminalId', 'isOwner', 'isAdmin', 'customClaims', 'emailVerified'
        ]))
      );
      allow delete: if hasFullAccess();
    }

    match /orders/{orderId} {
      allow read: if hasFullAccess() || 
                  (isSignedIn() && resource.data.userId == request.auth.uid) || 
                  (isDeliveryPartner() && resource.data.deliveryPartnerId == request.auth.uid);
      allow write: if hasFullAccess();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }

    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }

    match /menu_categories/{categoryId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }
    
    match /combos/{comboId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }

    match /ads/{adId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }
    
    match /coupons/{couponId} {
      allow read: if isSignedIn() || hasFullAccess();
      allow write: if hasFullAccess();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }

    match /delivery_zones/{zoneId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }

    match /delivery_partners/{partnerId} {
      allow read: if hasFullAccess() || (request.auth != null && request.auth.uid == partnerId);
      // Riders can only update their own telemetry/status fields, not administrative status or assigned branch
      allow create: if hasFullAccess();
      allow update: if hasFullAccess() || (
        request.auth != null && request.auth.uid == partnerId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isApproved', 'status', 'commissionRate', 'assignedBranchId', 'franchiseId', 'role'
        ])
      );
      allow delete: if hasFullAccess();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow read: if hasFullAccess() || isOwner(resource.data.userId);
      allow write: if hasFullAccess();
    }

    // --- OPERATIONAL DATA ---

    match /device_heartbeats/{sessionId} {
      allow read: if hasFullAccess() || isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
      allow update: if isOwner(resource.data.uid);
      allow delete: if hasFullAccess();
    }
    
    match /user_carts/{userId} {
      allow read, write: if isOwner(userId) || hasFullAccess();
    }
    
    match /client_errors/{errorId} {
      allow create: if true;
      allow read, update, delete: if hasFullAccess();
    }
    
    match /activity_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if hasFullAccess();
    }
    
    match /crash_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if hasFullAccess();
    }

    match /home_layout/{document=**} {
      allow read: if true;
      allow write: if hasFullAccess();
    }
    
    match /home_layout_versions/{versionId} {
      allow read, write: if hasFullAccess();
    }

    // --- DPDP PRIVACY & GOVERNANCE COLLECTIONS ---

    match /privacy_policy_versions/{versionId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }

    match /privacy_retention_policies/{policyId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }

    match /privacy_processors/{processorId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }

    match /user_consents/{userId} {
      allow read: if isOwner(userId) || hasFullAccess();
      allow write: if hasFullAccess();
    }

    match /consent_audit_logs/{logId} {
      allow read, write: if hasFullAccess();
    }

    match /privacy_grievances/{ticketId} {
      allow read: if hasFullAccess() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if hasFullAccess();
    }

    match /deletion_requests/{docId} {
      allow read: if hasFullAccess() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if hasFullAccess();
    }

    match /security_incidents/{incidentId} {
      allow read, write: if hasFullAccess();
    }

    match /privacy_audit_logs/{logId} {
      allow read, write: if hasFullAccess();
    }
    
    match /{document=**} {
      allow read, write: if hasFullAccess();
    }
  }
}
