rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'olivepizzarjn@gmail.com' ||
        request.auth.token.email == 'webhub2811@gmail.com'
      );
    }

    function isAppOwner() {
      return request.auth != null && (
        request.auth.token.role == 'owner' ||
        request.auth.token.email == 'olivepizzarjn@gmail.com' ||
        request.auth.token.email == 'webhub2811@gmail.com'
      );
    }

    function hasFullAccess() {
      return isAdmin() || isAppOwner();
    }

    function isDeliveryPartner() {
      return request.auth != null && request.auth.token.role == 'delivery_partner';
    }

    // --- PROTECTED BUSINESS COLLECTIONS ---
    
    match /users/{userId} {
      allow read: if isOwner(userId) || hasFullAccess();
      allow write: if hasFullAccess() || isOwner(userId);
    }

    match /orders/{orderId} {
      allow read: if hasFullAccess() || 
                  (isSignedIn() && resource.data.userId == request.auth.uid) || 
                  (isDeliveryPartner() && (resource.data.deliveryPartnerId == request.auth.uid || resource.data.status in ['ready', 'packed', 'partner_assigned', 'picked_up', 'out_for_delivery']));
      allow write: if hasFullAccess();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }

    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }

    match /menu_categories/{categoryId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }
    
    match /combos/{comboId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }

    match /ads/{adId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }
    
    match /coupons/{couponId} {
      allow read: if isSignedIn() || hasFullAccess();
      allow write: if hasFullAccess();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }

    match /delivery_zones/{zoneId} {
      allow read: if true;
      allow write: if hasFullAccess();
    }

    match /delivery_partners/{partnerId} {
      allow read: if hasFullAccess() || (request.auth != null && request.auth.uid == partnerId);
      allow write: if hasFullAccess() || (request.auth != null && request.auth.uid == partnerId);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow read: if hasFullAccess() || isOwner(resource.data.userId);
      allow write: if hasFullAccess();
    }

    // --- OPERATIONAL DATA ---

    match /device_heartbeats/{sessionId} {
      allow read: if hasFullAccess() || isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
      allow update: if isOwner(resource.data.uid);
      allow delete: if hasFullAccess();
    }
    
    match /user_carts/{userId} {
      allow read, write: if isOwner(userId) || hasFullAccess();
    }
    
    match /client_errors/{errorId} {
      allow create: if true;
      allow read, update, delete: if hasFullAccess();
    }
    
    match /activity_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if hasFullAccess();
    }
    
    match /crash_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if hasFullAccess();
    }

    match /home_layout/{document=**} {
      allow read: if true;
      allow write: if hasFullAccess();
    }
    
    match /home_layout_versions/{versionId} {
      allow read, write: if hasFullAccess();
    }
    
    match /{document=**} {
      allow read, write: if hasFullAccess();
    }
  }
}
