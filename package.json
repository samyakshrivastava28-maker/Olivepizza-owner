{
  "name": "olive-pizza-owner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx backend/server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "cd frontend && npm install --legacy-peer-deps && npm run build",
    "build:backend": "cd backend && npm install",
    "build": "npm run build:frontend && mkdir -p dist && cp -r frontend/dist/* dist/ || true",
    "start": "tsx backend/server.ts",
    "server": "tsx backend/server.ts"
  },
